# ── HashBack (HashPay) credentials ──────────────────────────────────────────
# Required. Without HASHBACK_API_KEY and HASHBACK_ACCOUNT_ID the server refuses
# the STK push with a 503 and no M-PESA prompt is ever sent — the single most
# common reason this stack appears "broken". Copy this file to .env and fill in
# the real values from your HashPay dashboard. On Vercel, set these as project
# environment variables instead of shipping a .env.
HASHBACK_API_KEY=your_api_key_here
HASHBACK_ACCOUNT_ID=your_account_id_here
HASHBACK_WEBHOOK_SECRET=your_webhook_secret_here

# ── Optional ────────────────────────────────────────────────────────────────
PORT=3000

# Vercel KV (Upstash REST). Set these on any serverless deployment so orders
# survive between the initiate call, the HashPay webhook and the status polls;
# Vercel injects them automatically once you attach a KV store. Leave blank
# locally — the server falls back to an in-memory Map, which is fine for a
# single local process.
KV_REST_API_URL=
KV_REST_API_TOKEN=
